    <script>
    function srSearch(){
        var q=document.getElementById('searchInput').value.toLowerCase().trim();
        document.querySelectorAll('[data-s]').forEach(function(el){
            el.style.display=(!q||el.getAttribute('data-s').toLowerCase().indexOf(q)>-1)?'':'none';
        });
        if(q){
            var t=document.getElementById('categories').getBoundingClientRect();
            if(t.bottom<0||t.top>window.innerHeight){document.getElementById('categories').scrollIntoView({behavior:'smooth'})}
        }
    }
    document.getElementById('yr').textContent=new Date().getFullYear();
    </script>

    <script>
    (function(){
        var io=new IntersectionObserver(function(es){es.forEach(function(x){
            if(!x.isIntersecting)return;io.unobserve(x.target);
            var n=+x.target.getAttribute('data-n'),s=0,st=Math.max(1,n/60);
            var t=setInterval(function(){s+=st;if(s>=n){s=n;clearInterval(t)}
                x.target.textContent=Math.round(s).toLocaleString()+(n>=100?'+':'')},25)})},{threshold:.6});
        document.querySelectorAll('.sr-nums [data-n]').forEach(function(el){io.observe(el)});
    })();
    </script>

    <!-- Sound toggle for the 4 top videos (browsers only allow autoplay when muted, so the visitor taps to hear) -->
    <script>
    (function(){
        var vids=document.querySelectorAll('.sr-vgrid video'),btns=document.querySelectorAll('.sr-snd');
        document.querySelectorAll('.sr-vgrid figure').forEach(function(fig){
            var v=fig.querySelector('video'),b=fig.querySelector('.sr-snd');
            if(!v||!b)return;
            function toggle(){
                var turnOn=v.muted;
                vids.forEach(function(o){o.muted=true});
                btns.forEach(function(x){x.textContent='🔇'});
                if(turnOn){v.muted=false;v.volume=1;var p=v.play();if(p&&p.catch)p.catch(function(){});b.textContent='🔊'}
            }
            b.addEventListener('click',function(e){e.stopPropagation();toggle()});
            v.addEventListener('click',toggle);
        });
    })();
    </script>

    <!-- ===== CUSTOMER REVIEWS: right-side slide-out panel ===== -->
    <button class="rev-tab" id="revTab" type="button">⭐ REVIEWS</button>
    <aside class="rev-panel" id="revPanel">
        <div class="rev-head">
            <h3>Customer Reviews</h3>
            <button class="rev-close" id="revClose" type="button" aria-label="Close">&times;</button>
        </div>
        <div class="rev-list" id="reviewList"></div>
        <div class="rev-form">
            <h4>Write a review</h4>
            <div class="sr-stars-pick" id="starPick">
                <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>
            </div>
            <input type="text" id="revName" placeholder="Your name">
            <textarea id="revText" rows="2" placeholder="Share your experience..."></textarea>
            <div class="rev-upload">
                <label for="revImage">🖼️ Upload photo</label>
                <input type="file" id="revImage" accept="image/*">
                <span id="revImageName">No photo chosen</span>
            </div>
            <div class="rev-upload">
                <label for="revVideo">🎥 Upload video</label>
                <input type="file" id="revVideo" accept="video/*">
                <span id="revVideoName">No video chosen</span>
            </div>
            <button type="button" id="revSubmit">Submit Review</button>
        </div>
    </aside>

    <!-- ===== CUSTOMER REVIEWS SCRIPT ===== -->
    <!-- Reviews are now stored in the server SQLite database. -->
    <script src="reviews-client.js"></script>

    <!-- ===== HERO SLIDER SCRIPT (auto-slides every 4 seconds) ===== -->
    <script>
    (function(){
        var s=document.getElementById('heroSlider'),
            track=s.querySelector('.hero-track'),
            slides=s.querySelectorAll('.hero-slide'),
            box=s.querySelector('.hero-dots'),
            i=0,timer,DELAY=4000;
        slides.forEach(function(_,n){
            var b=document.createElement('button');
            b.setAttribute('aria-label','Slide '+(n+1));
            b.onclick=function(){go(n);restart()};
            box.appendChild(b);
        });
        var dots=box.querySelectorAll('button');
        function go(n){
            i=(n+slides.length)%slides.length;
            track.style.transform='translateX('+(-i*100)+'%)';
            dots.forEach(function(d,k){d.classList.toggle('active',k===i)});
        }
        function restart(){clearInterval(timer);timer=setInterval(function(){go(i+1)},DELAY)}
        s.querySelector('.hero-prev').onclick=function(){go(i-1);restart()};
        s.querySelector('.hero-next').onclick=function(){go(i+1);restart()};
        s.addEventListener('mouseenter',function(){clearInterval(timer)});
        s.addEventListener('mouseleave',restart);
        var x0=null;
        s.addEventListener('touchstart',function(e){x0=e.touches[0].clientX},{passive:true});
        s.addEventListener('touchend',function(e){
            if(x0===null)return;
            var dx=e.changedTouches[0].clientX-x0;
            if(Math.abs(dx)>40){go(dx<0?i+1:i-1);restart()}
            x0=null;
        });
        go(0);restart();
    })();
    </script>

    <script src="script.js"></script>

</body>
</html>
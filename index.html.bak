<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resin Art Store - Saubhagya</title>

    <link rel="stylesheet" href="style.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* SCROLLING OFFER BAR */
        .offer-bar { background: #000; overflow: hidden; white-space: nowrap; position: relative; width: 100%; }
        .offer-bar-track { display: inline-flex; animation: scroll-offer 18s linear infinite; }
        .offer-bar-track span { padding: 10px 40px; color: #fff; font-weight: 600; font-size: 14px; white-space: nowrap; }
        /* highlight the free shipping line */
        .offer-bar-track span.highlight { color: #f5b400; }
        @keyframes scroll-offer { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
        /* pause on hover */
        .offer-bar:hover .offer-bar-track { animation-play-state: paused; }

        /* CENTERED, LARGER LOGO */
        .nav-top { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
        .logo { width: 100%; display: flex; justify-content: center; margin-bottom: 10px; }
        .logo img { height: 90px; width: auto; }
        .main-menu { display: flex; justify-content: center; gap: 30px; }

        /* SECONDARY MENU + DROPDOWN */
        .secondary-menu { display: flex; align-items: center; justify-content: center; gap: 40px; }
        .dropdown { position: relative; display: inline-block; }
        .dropdown-content { display: none; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); background: #fff; box-shadow: 0 8px 20px rgba(0,0,0,0.12); padding: 20px; gap: 20px; z-index: 50; border-radius: 6px; }
        .dropdown:hover .dropdown-content { display: flex; }
        .dropdown-content a { display: flex; flex-direction: column; align-items: center; width: 110px; text-decoration: none; color: #333; font-size: 12px; font-weight: 500; }
        .dropdown-content a img { width: 90px; height: 90px; object-fit: cover; border-radius: 4px; margin-bottom: 8px; }

        /* FLOATING CONTACT PANEL - bottom right corner */
        .contact-panel { position: fixed; bottom: 24px; right: 24px; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; z-index: 999; }
        .contact-panel-details { display: none; flex-direction: column; gap: 6px; background: #fff; padding: 14px 18px; border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.15); font-size: 13px; font-weight: 500; color: #333; white-space: nowrap; }
        .contact-panel.open .contact-panel-details { display: flex; }
        .whatsapp-fab { width: 52px; height: 52px; background: #25D366; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,0.25); transition: transform 0.2s ease; }
        .whatsapp-fab:hover { transform: scale(1.1); }

        /* ===== NEW: HERO BANNER + PRODUCT HOVER ===== */
        .sr-videos{padding:30px 5vw;background:#0d1b2a}
        .sr-vgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;max-width:1100px;margin:0 auto}
        .sr-vgrid figure{position:relative;margin:0;aspect-ratio:3/4;border-radius:14px;overflow:hidden;background:#1b2f45;display:flex;align-items:center;justify-content:center;color:#9fb3c8;font-family:'Montserrat',sans-serif;font-size:13px;text-align:center}
        .sr-vgrid video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
        .sr-vgrid figure:has(video) figcaption{display:none}
        .sr-snd{position:absolute;right:10px;bottom:10px;z-index:3;width:42px;height:42px;border:0;border-radius:50%;background:rgba(0,0,0,.65);color:#fff;font-size:19px;cursor:pointer;backdrop-filter:blur(4px);transition:background .2s}
        .sr-snd:hover{background:#f5b400}
        .sr-vgrid video{cursor:pointer}
        .product-card{transition:transform .2s ease,box-shadow .2s ease}
        .product-card:hover{transform:translateY(-6px);box-shadow:0 12px 26px rgba(0,0,0,.12)}

        /* ===== NEW: ACHIEVEMENTS + INSTAGRAM VIDEO ===== */
        .sr-sec{padding:60px 5vw;font-family:'Montserrat',sans-serif;text-align:center}
        .sr-sec h2{font-size:clamp(1.5rem,3.5vw,2.2rem);font-weight:800;margin:0 0 6px}
        .sr-widget{max-width:1200px;margin:0 auto;padding:0 20px 10px;background:#fff;border-radius:16px}
        .sr-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;max-width:1100px;margin:36px auto 0}
        .sr-gallery figure{position:relative;margin:0;aspect-ratio:4/3;border:2px dashed #ccc;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#fff;color:#999;font-size:13px}
        .sr-gallery img,.sr-gallery video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
        .sr-gallery figure:has(img),.sr-gallery figure:has(video){border:0}
        .sr-gallery figure:has(img) figcaption,.sr-gallery figure:has(video) figcaption{display:none}
        .sr-sub{color:#666;margin:0 0 30px;font-size:14px}
        .sr-nums{display:flex;flex-wrap:wrap;gap:30px;justify-content:center}
        .sr-nums div{min-width:140px;font-size:13px;color:#555}
        .sr-nums b{display:block;font-size:clamp(2rem,5vw,3rem);font-weight:800;color:#000}
        .sr-awards{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:26px}
        .sr-awards span{padding:8px 18px;border-radius:50px;background:#fff7dc;border:1px solid #f5b400;font-size:13px;font-weight:600}
        .sr-ig{background:#fafafa}
        .sr-ig iframe{border:0;max-width:100%;border-radius:12px}
        .sr-ig a{display:inline-block;margin-top:16px;color:#000;font-weight:600}

        /* remove extra blank space between products and features */
        .products{padding-bottom:20px !important;margin-bottom:0 !important}
        .features{margin-top:0 !important}

        /* ===== VISION & MISSION ===== */
        .sr-vm{padding:60px 5vw;background:#fff;font-family:'Montserrat',sans-serif}
        .sr-vm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;max-width:1200px;margin:0 auto;justify-content:center}
        @media(max-width:900px){.sr-vm-grid{grid-template-columns:1fr}}
        .sr-vm-card .ico,.sr-vm-card h2{text-align:center}
        .sr-vm-card{background:#fafafa;border:1px solid #eee;border-top:4px solid #f5b400;border-radius:14px;padding:28px;text-align:left;transition:transform .2s,box-shadow .2s}
        .sr-vm-card:hover{transform:translateY(-5px);box-shadow:0 12px 26px rgba(0,0,0,.1)}
        .sr-vm-card .ico{font-size:34px;margin-bottom:8px}
        .sr-vm-card h2{font-size:clamp(1.3rem,3vw,1.7rem);font-weight:800;margin:0 0 12px}
        .sr-vm-card p{font-size:14px;line-height:1.7;color:#444;margin:0 0 10px}
        .sr-vm-card ul{margin:8px 0 0;padding-left:20px;font-size:14px;line-height:1.8;color:#444}
        .sr-ig-card{grid-column:1/-1;display:flex;align-items:center;gap:20px;flex-wrap:wrap;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);color:#fff;border-radius:14px;padding:24px 28px;text-decoration:none;transition:transform .2s,box-shadow .2s}
        .sr-ig-card:hover{transform:translateY(-4px);box-shadow:0 12px 26px rgba(0,0,0,.22)}
        .sr-ig-card svg{flex-shrink:0}
        .sr-ig-card div{flex:1;min-width:220px;text-align:left}
        .sr-ig-card h3{margin:0 0 6px;font-size:1.15rem;font-weight:800}
        .sr-ig-card p{margin:0;font-size:14px;line-height:1.6}
        .sr-ig-btn{background:#fff;color:#000;padding:10px 20px;border-radius:50px;font-weight:700;font-size:13px;white-space:nowrap}
        /* NEW: both Instagram buttons below the banner */
        .sr-ig-row{grid-column:1/-1;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:6px}
        .sr-hl{max-width:760px;margin:0 auto 30px;background:#fff7dc;border:1px solid #f5b400;border-radius:16px;padding:28px}
        .sr-hl-num{font-size:clamp(2.5rem,7vw,4rem);font-weight:800;color:#000;line-height:1}
        .sr-hl h3{margin:6px 0 12px;font-size:1.2rem}
        .sr-hl p{font-size:14px;line-height:1.7;color:#444;margin:0 0 10px}

        /* ===== CUSTOMER REVIEWS - RIGHT SIDE PANEL ===== */
        .rev-tab{position:fixed;right:0;top:45%;z-index:1000;background:#000;color:#fff;border:0;padding:14px 10px;border-radius:10px 0 0 10px;font-family:'Montserrat',sans-serif;font-weight:700;font-size:13px;letter-spacing:1px;cursor:pointer;writing-mode:vertical-rl;box-shadow:-3px 3px 12px rgba(0,0,0,.25);transition:background .2s}
        .rev-tab:hover{background:#f5b400;color:#000}
        .rev-panel{position:fixed;top:0;right:0;height:100%;width:340px;max-width:90vw;background:#fff;z-index:1001;box-shadow:-6px 0 24px rgba(0,0,0,.2);transform:translateX(105%);transition:transform .3s ease;display:flex;flex-direction:column;font-family:'Montserrat',sans-serif}
        .rev-panel.open{transform:translateX(0)}
        .rev-head{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;background:#000;color:#fff}
        .rev-head h3{margin:0;font-size:16px;font-weight:700}
        .rev-close{background:none;border:0;color:#fff;font-size:24px;cursor:pointer;line-height:1}
        .rev-list{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:12px}
        .sr-rev-card{background:#fafafa;border:1px solid #eee;border-radius:12px;padding:14px;text-align:left}
        .sr-rev-card .stars{color:#f5b400;font-size:16px;letter-spacing:2px}
        .sr-rev-card p{font-size:13px;color:#444;margin:8px 0}
        .sr-rev-card b{font-size:12px}
        .rev-del{display:block;margin-top:10px;background:none;border:1px solid #d33;color:#d33;border-radius:50px;padding:5px 12px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit}
        .rev-del:hover{background:#d33;color:#fff}
        .rev-img{width:100%;max-height:300px;border-radius:10px;margin-top:8px;object-fit:cover}
        .rev-video{width:100%;max-height:300px;border-radius:10px;margin-top:8px;background:#000;object-fit:cover}
        .rev-form{padding:14px;border-top:1px solid #eee;background:#fff7dc}
        .rev-form h4{margin:0 0 8px;font-size:14px}
        .rev-form input,.rev-form textarea{width:100%;padding:9px;margin-bottom:8px;border:1px solid #ccc;border-radius:8px;font-family:inherit;font-size:13px;box-sizing:border-box}
        .sr-stars-pick{font-size:24px;color:#ccc;cursor:pointer;margin-bottom:6px;user-select:none}
        .sr-stars-pick span.on{color:#f5b400}
        .rev-upload{display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:12px}
        .rev-upload label{background:#fff;border:1px dashed #000;border-radius:8px;padding:8px 12px;cursor:pointer;font-weight:600;white-space:nowrap}
        .rev-upload label:hover{background:#f5b400}
        .rev-upload input{display:none}
        #revVideoName,#revImageName{color:#555;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .rev-form button{background:#000;color:#fff;border:0;padding:10px 22px;border-radius:50px;font-weight:600;cursor:pointer}
        .rev-form button:hover{background:#f5b400;color:#000}

        /* ===== NEW LAYOUT ===== */
        html{scroll-behavior:smooth}
        .sr-sec-title{text-align:center;font-family:'Montserrat',sans-serif;font-size:clamp(1.4rem,3.2vw,2rem);font-weight:800;letter-spacing:2px;margin:0 0 34px;text-transform:uppercase}
        .sr-sec-title::after{content:'';display:block;width:60px;height:3px;background:#f5b400;margin:10px auto 0}
        .sr-blk{padding:60px 5vw;font-family:'Montserrat',sans-serif;background:#fff}
        .sr-blk.alt{background:#fafafa}
        .sr-hero{position:relative;overflow:hidden;min-height:520px;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;background:#222;padding:60px 5vw;font-family:'Montserrat',sans-serif}
        .sr-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.55));z-index:1}
        .sr-hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
        .sr-hero>div{position:relative;z-index:2}
        .sr-hero-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
        .sr-btn.ghost{background:transparent;color:#fff;border:2px solid #fff;padding:12px 34px}
        .sr-btn.ghost:hover{background:#fff;color:#000}
        .header-right a{text-decoration:none}
        .studio-box{display:grid;grid-template-columns:1fr 1fr;gap:30px;max-width:1000px;margin:0 auto;align-items:center;background:#fff;border:1px solid #eee;border-radius:16px;padding:28px}
        .studio-box img{width:100%;max-height:320px;object-fit:cover;border-radius:12px}
        .studio-box h3{margin:0 0 10px;font-size:1.3rem;font-weight:800}
        .studio-box p{font-size:14px;line-height:1.7;color:#444;margin:0 0 12px}
        .studio-box ul{list-style:none;padding:0;margin:0 0 18px;font-size:14px;line-height:2;color:#333}
        @media(max-width:800px){.studio-box{grid-template-columns:1fr}}
        .sr-hero h1{font-size:clamp(2rem,6vw,3.8rem);font-weight:800;letter-spacing:3px;margin:0 0 12px}
        .sr-hero p{font-size:clamp(.95rem,2vw,1.2rem);margin:0 0 28px}
        .sr-btn{display:inline-block;background:#f5b400;color:#000;padding:14px 38px;border-radius:50px;font-weight:700;letter-spacing:1px;text-decoration:none;border:0;cursor:pointer;font-family:inherit;font-size:14px;transition:transform .2s,background .2s,color .2s}
        .sr-btn:hover{transform:translateY(-3px);background:#fff;color:#000}
        .sr-btn.dark{background:#000;color:#fff}
        .sr-btn.dark:hover{background:#f5b400;color:#000}
        .cat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:24px;max-width:1100px;margin:0 auto}
        .cat-card{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#222;font-weight:600;font-size:14px;gap:12px;text-align:center;transition:transform .2s}
        .cat-card:hover{transform:translateY(-6px)}
        .cat-card img{width:150px;height:150px;border-radius:50%;object-fit:cover;border:3px solid #f5b400}
        .pg{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px;max-width:1100px;margin:0 auto}
        .pc{position:relative;background:#fff;border:1px solid #eee;border-radius:14px;overflow:hidden;text-decoration:none;color:#222;text-align:center;padding-bottom:18px;transition:transform .2s,box-shadow .2s}
        .pc:hover{transform:translateY(-6px);box-shadow:0 12px 26px rgba(0,0,0,.12)}
        .pc img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
        .pc h3{font-size:15px;margin:14px 10px 6px;font-weight:700}
        .pc p{font-size:13px;color:#666;margin:0 12px 10px}
.pc-fit img{object-fit:contain;background:#fdf4f1}
        .pc .tag{position:absolute;top:10px;left:10px;background:#000;color:#f5b400;font-size:11px;font-weight:700;padding:4px 10px;border-radius:50px}
        .pc .price{color:#1a8a3c;font-weight:700;font-size:14px}
        .sr-videos.sr-ig-sec{padding:60px 5vw}
        .sr-ig-sec .sr-sec-title{color:#fff}
        .sr-ig-big{text-align:center;color:#f5b400;font-family:'Montserrat',sans-serif;font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;margin:-10px 0 26px}
        .sr-ig-links{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:28px}
        .rv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;max-width:1100px;margin:0 auto 28px}
        .rv-cta{text-align:center}
        .sr-vm-card .big{font-size:2.6rem;font-weight:800;text-align:center;line-height:1;margin:4px 0}
        .sr-vm-card .sub-h{text-align:center;font-weight:700;margin:0 0 12px}
        .sr-footer{background:#000;color:#ddd;font-family:'Montserrat',sans-serif;padding:50px 5vw 20px}
        .sr-foot-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:30px;max-width:1100px;margin:0 auto 30px}
        .sr-footer h4{color:#f5b400;margin:0 0 14px;font-size:14px;letter-spacing:1px}
        .sr-footer a{display:block;color:#ddd;text-decoration:none;font-size:13px;margin-bottom:8px;cursor:pointer}
        .sr-footer a:hover{color:#f5b400}
        .sr-footer p{font-size:13px;line-height:1.7;margin:0 0 8px}
        .sr-footer img{height:70px;width:auto;border-radius:6px;margin-bottom:12px}
        .sr-foot-bottom{border-top:1px solid #333;padding-top:16px;text-align:center;font-size:12px;color:#999}

        /* ===== CENTERED MENU (logo > menu in the middle, search/icons on the right) ===== */
        .navbar .nav-bottom{display:grid !important;grid-template-columns:1fr auto 1fr;align-items:center}
        .navbar .nav-bottom .secondary-menu{grid-column:2;justify-content:center}
        .navbar .nav-bottom .header-right{grid-column:3;justify-self:end}
        @media(max-width:900px){
            .navbar .nav-bottom{grid-template-columns:1fr;row-gap:10px}
            .navbar .nav-bottom .secondary-menu,.navbar .nav-bottom .header-right{grid-column:1;justify-self:center}
        }

        /* ===== HERO SLIDER (4 auto-sliding images) ===== */
        .hero-slider{position:relative;width:100%;overflow:hidden;background:#fff3f6;font-family:'Montserrat',sans-serif}
        .hero-track{display:flex;transition:transform .8s ease}
        .hero-slide{min-width:100%;height:400px;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr);align-items:center;overflow:hidden}
        .hero-text{padding:0 9%}
        .hero-text small{letter-spacing:3px;font-weight:700;color:#c2185b;font-size:12px}
        .hero-text h2{font-size:clamp(1.6rem,3.6vw,2.8rem);font-weight:800;margin:8px 0 10px;color:#222}
        .hero-text p{font-size:15px;line-height:1.7;color:#555;margin:0 0 22px}
        .hero-slide img{width:100%;height:100%;max-height:100%;object-fit:contain;object-position:center;padding:18px;box-sizing:border-box;display:block}
        .hero-slide.s1{background:linear-gradient(135deg,#fff3f6,#fde1ea)}
        .hero-slide.s2{background:linear-gradient(135deg,#f5eeff,#e6dcff)}
        .hero-slide.s3{background:linear-gradient(135deg,#fff6e9,#ffe9c4)}
        .hero-slide.poster{display:flex;justify-content:center;background:#f7e9e0}
        .hero-slide.poster img{width:auto;height:100%;object-fit:contain}
        .hero-arrow{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border:0;border-radius:50%;background:rgba(255,255,255,.85);font-size:18px;cursor:pointer;z-index:5;box-shadow:0 2px 8px rgba(0,0,0,.2)}
        .hero-arrow:hover{background:#f5b400}
        .hero-prev{left:14px}.hero-next{right:14px}
        .hero-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:5}
        .hero-dots button{width:10px;height:10px;border-radius:50%;border:0;padding:0;background:rgba(0,0,0,.25);cursor:pointer;transition:all .3s}
        .hero-dots button.active{background:#f5b400;width:26px;border-radius:6px}
        @media(max-width:800px){
            .hero-slide{grid-template-columns:1fr;height:auto}
            .hero-slide img{order:-1;height:260px}
            .hero-text{padding:20px 6% 44px;text-align:center}
            .hero-slide.poster{height:auto}
            .hero-slide.poster img{width:100%;height:auto;max-height:420px}
            .hero-arrow{display:none}
        }

        /* ===== SOFT AESTHETIC BACKGROUND FOR THE TOP SECTION ===== */
        #home{position:relative;overflow:hidden;background:radial-gradient(rgba(214,140,170,.22) 1px,transparent 1.6px) 0 0/24px 24px,linear-gradient(135deg,#fff3f6 0%,#f5eeff 50%,#fff6e9 100%)}
        #home::before{content:'';position:absolute;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(244,143,177,.38),transparent 70%);top:-150px;left:-120px;pointer-events:none}
        #home::after{content:'';position:absolute;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(167,139,250,.32),transparent 70%);bottom:-190px;right:-140px;pointer-events:none}
        #home>*{position:relative;z-index:1}
        #home .studio-box{background:rgba(255,255,255,.88);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.9);box-shadow:0 16px 44px rgba(190,120,170,.18)}
    </style>
       <link rel="stylesheet" href="review-panel-style.css?v=2">
</head>

<body>

    <!-- TOP OFFER BAR -->
    <div class="offer-bar">
        <div class="offer-bar-track">
            <span>🎉 EXTRA 10% OFF ON ORDER ABOVE 10,000/-</span>
            <span class="highlight">FREE SHIPPING ON ORDER ABOVE 5000/-</span>
            <span>🎉 EXTRA 10% OFF ON ORDER ABOVE 10,000/-</span>
            <!-- duplicate set for seamless loop -->
            <span>🎉 EXTRA 10% OFF ON ORDER ABOVE 10,000/-</span>
            <span class="highlight">FREE SHIPPING ON ORDER ABOVE 5000/-</span>
            <span>🎉 EXTRA 10% OFF ON ORDER ABOVE 10,000/-</span>
        </div>
    </div>

    <!-- NAVBAR -->
    <header class="navbar">

        <div class="nav-top">
            <div class="logo">
                <img src="images/logo.jpg" alt="Saubhagya Logo">
            </div>

            <nav class="main-menu">
            </nav>
        </div>

        <div class="nav-bottom">
            <nav class="secondary-menu">
                <a href="index.html">HOME</a>

                <div class="dropdown">
                    <a href="#categories" class="dropbtn">COLLECTIONS</a>
                    <div class="dropdown-content">
